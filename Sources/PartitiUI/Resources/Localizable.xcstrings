{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ asks once, the first time it can check, whether to check automatically from then on." : {
      "comment" : "The footer of the Updates group in About. The argument is the app name.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo chiede una sola volta, alla prima verifica possibile, se controllare automaticamente da quel momento in poi."
          }
        }
      }
    },
    "Automatically check for updates" : {
      "comment" : "A settings row in About.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla automaticamente gli aggiornamenti"
          }
        }
      }
    },
    "Buy Me a Coffee" : {
      "comment" : "The Coffee capsule in About.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
